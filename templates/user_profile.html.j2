{% extends "base.html.j2" %}
{% block content %}
{% from "macros/user_macros.html.j2" import user_display%}

<div class="container mt-5">

  <!-- User Profile Information Card -->
  <div class="card col-lg-8 mx-auto">
    <div class="row g-0 align-items-center">
      <div class="col-md-12">
        <div class="card-body">
          <h2 class="card-title">
            {{ user_display(user.username) }}
            {% if is_newcomer %}
            <span class="badge bg-success align-middle fs-6 fw-normal" title="Joined {% if account_age_days == 0 %}today{% elif account_age_days == 1 %}1 day ago{% else %}{{ account_age_days }} days ago{% endif %}">🌱 New member</span>
            {% endif %}
          </h2>
          <p class="card-text text-muted mb-3">
            <strong>Location:</strong> {{ user.location or "N/A" }}<br>
            <strong>Birthdate:</strong> {{ user.birthdate or "N/A" }}<br>
            <strong>Joined:</strong> {{ user.created_at|datetimeformat }}
          </p>
          <p class="card-text">{{ user.profile or "No profile information provided." }}</p>

          {% if is_own_profile %}
            <div class="my-3" id="interests-view">
              <strong>Your Interests:</strong>
              {% for interest in user_interests %}
                <span class="badge bg-primary me-1">{{ interest }}</span>
              {% else %}
                <span class="text-muted">You haven't added any interests yet.</span>
              {% endfor %}
              <button type="button" class="btn btn-sm btn-warning ms-2" id="edit-interests-btn">Edit Interests</button>
            </div>

            <form action="{{ url_for('update_interests') }}" method="POST" class="my-3 d-none" id="interests-edit">
              <label for="interest-input" class="form-label"><strong>Edit Interests</strong></label>
              <div class="form-text mt-0 mb-1">Tip: to use two words as one tag, link them with a "-" (e.g. Machine-Learning).</div>
              <div class="form-control d-flex flex-wrap align-items-center gap-1" id="interest-box" style="cursor: text;">
                <div id="interest-tags" class="d-flex flex-wrap gap-1"></div>
                <input type="text" id="interest-input" class="border-0 flex-grow-1" style="outline: none; min-width: 120px;" placeholder="Type an interest and press space">
              </div>
              <input type="hidden" id="interests" name="interests">
              <div class="mt-2">
                <button type="submit" class="btn btn-sm btn-primary">Save</button>
                <button type="button" class="btn btn-sm btn-light" id="cancel-interests-btn">Cancel</button>
              </div>
            </form>
          {% elif shared_interests %}
            <div class="my-3">
              <strong>Shared Interests:</strong> You and {{ user.username }} both share:
              {% for interest in shared_interests %}
                <span class="badge bg-primary me-1">{{ interest }}</span>
              {% endfor %}
            </div>
          {% endif %}

         {% if session.user_id and session.user_id != user.id %}
            <div class="my-3">
              {# The logic is now a simple boolean check #}
              {% if is_following %}
                <form action="{{ url_for('unfollow_user', user_id=user.id) }}" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-secondary">Unfollow</button>
                </form>
              {% else %}
                <form action="{{ url_for('follow_user', user_id=user.id) }}" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-primary">Follow</button>
                </form>
              {% endif %}
            </div>
          {% endif %}

          <div class="mt-4 d-flex">
            <div class="me-4">
              <a href="/u/{{ user.username }}/followers" class="text-decoration-none text-dark">
                <strong>{{ followers_count }}</strong> Followers
              </a>
            </div>
            <div>
              <a href="/u/{{ user.username }}/following" class="text-decoration-none text-dark">
                <strong>{{ following_count }}</strong> Following
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <h3 class="text-center border-bottom pb-2 my-5"><span>Latest Posts</span></h3>

  <div class="row g-3">
    {% for post in posts %}
    <div class="col-md-6">
      <div class="card h-100 shadow-sm card-hover">
        <a href="{{ url_for('post_detail', post_id=post.id) }}" class="text-decoration-none text-reset">
          <div class="card-body">
            <p class="card-text">{{ post.content|truncate(100, True, '...') }}</p>
            <small class="text-muted">Posted on {{ post.created_at|datetimeformat }}</small>
          </div>
        </a>
      </div>
    </div>
    {% else %}
    <div class="col-12">
      <p class="text-center text-muted">No posts yet.</p>
    </div>
    {% endfor %}
  </div>

  <!-- User's Latest Comments Section -->
  <h3 class="text-center border-bottom pb-2 my-5"><span>Latest Comments</span></h3>

  <div class="row g-3">
    {% for comment in comments %}
    <div class="col-md-6">
      <div class="card h-100 shadow-sm card-hover">
        <!-- The link now goes to the post the comment is on -->
        <a href="{{ url_for('post_detail', post_id=comment.post_id) }}" class="text-decoration-none text-reset">
          <div class="card-body">
            <!-- Display the comment content -->
            <p class="card-text">{{ comment.content|truncate(100, True, '...') }}</p>
            <!-- Updated text to show it's a comment -->
            <small class="text-muted">Commented on {{ comment.created_at|datetimeformat }}</small>
          </div>
        </a>
      </div>
    </div>
    {% else %}
    <div class="col-12">
      <p class="text-center text-muted">No comments yet.</p>
    </div>
    {% endfor %}
  </div>

</div>

{% if is_own_profile %}
<script src="{{ url_for('static', filename='interest_tags.js') }}"></script>
<script>
  (function () {
    const saved = {{ user_interests|tojson }};
    const tags = initInterestTags(saved);
    const view = document.getElementById('interests-view');
    const edit = document.getElementById('interests-edit');

    document.getElementById('edit-interests-btn').addEventListener('click', function () {
      view.classList.add('d-none');
      edit.classList.remove('d-none');
      document.getElementById('interest-input').focus();
    });

    // Cancel throws away unsaved changes
    document.getElementById('cancel-interests-btn').addEventListener('click', function () {
      tags.reset(saved);
      edit.classList.add('d-none');
      view.classList.remove('d-none');
    });
  })();
</script>
{% endif %}
{% endblock %}
