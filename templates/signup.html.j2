{% extends "base.html.j2" %}
{% block content %}
<div class="container col-md-6 mx-auto mt-5">
  <div class="card p-4">
    <h2 class="mb-4 text-center">Sign Up</h2>
    <form method="POST">
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input type="text" class="form-control" id="username" name="username" required>
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input type="password" class="form-control" id="password" name="password" required>
      </div>
      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input type="text" class="form-control" id="location" name="location">
      </div>
      <div class="mb-3">
        <label for="birthdate" class="form-label">Birthdate</label>
        <input type="date" class="form-control" id="birthdate" name="birthdate">
      </div>
      <div class="mb-3">
        <label for="profile" class="form-label">Profile</label>
        <textarea class="form-control" id="profile" name="profile" rows="3"></textarea>
      </div>
      <div class="mb-3">
        <label for="interest-input" class="form-label">Interests</label>
        <div class="form-text mt-0 mb-1">Tip: to use two words as one tag, link them with a "-" (e.g. Machine-Learning).</div>
        <div class="form-control d-flex flex-wrap align-items-center gap-1" id="interest-box" style="cursor: text;">
          <div id="interest-tags" class="d-flex flex-wrap gap-1"></div>
          <input type="text" id="interest-input" class="border-0 flex-grow-1" style="outline: none; min-width: 120px;" placeholder="Type an interest and press space">
        </div>
        <input type="hidden" id="interests" name="interests">
      </div>
      <div class="d-grid">
        <button type="submit" class="btn btn-primary">Sign Up</button>
      </div>
    </form>
    <div class="text-center mt-3">
      <small class="text-muted">
        Already have an account? <a href="/login">Login</a>
      </small>
    </div>
  </div>
</div>

<script>
  (function () {
    const box = document.getElementById('interest-box');
    const input = document.getElementById('interest-input');
    const tagList = document.getElementById('interest-tags');
    const hidden = document.getElementById('interests');
    const interests = [];

    function render() {
      tagList.innerHTML = '';
      interests.forEach(function (interest, index) {
        const tag = document.createElement('span');
        tag.className = 'badge bg-primary d-inline-flex align-items-center';

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'btn-close btn-close-white me-1';
        remove.style.fontSize = '0.5rem';
        remove.setAttribute('aria-label', 'Remove ' + interest);
        remove.addEventListener('click', function () {
          interests.splice(index, 1);
          render();
          input.focus();
        });

        tag.appendChild(remove);
        tag.appendChild(document.createTextNode(interest));
        tagList.appendChild(tag);
      });
      hidden.value = interests.join(', ');
    }

    function addInterest() {
      const value = input.value.trim().replace(/,/g, '');
      input.value = '';
      if (!value) return;
      // Skip duplicates, ignoring case
      if (interests.some(i => i.toLowerCase() === value.toLowerCase())) return;
      interests.push(value);
      render();
    }

    input.addEventListener('keydown', function (e) {
      if (e.key === ' ' || e.key === 'Enter' || e.key === ',') {
        e.preventDefault();
        addInterest();
      } else if (e.key === 'Backspace' && input.value === '' && interests.length) {
        interests.pop();
        render();
      }
    });

    // Clicking anywhere in the box focuses the text input
    box.addEventListener('click', function (e) {
      if (e.target === box || e.target === tagList) input.focus();
    });

    // Include anything still typed in the box when the form is submitted
    input.form.addEventListener('submit', addInterest);
  })();
</script>
{% endblock %}```

**Change Made:**
*   Added the following block after the `</form>` tag:
    ```html
    <div class="text-center mt-3">
      <small class="text-muted">
        Already have an account? <a href="/login">Login</a>
      </small>
    </div>
    ```

These additions create a clear and user-friendly navigation path between your two main authentication pages.